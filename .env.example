HA_URL=http://ha.example.invalid:8123
HA_TOKEN=replace-with-a-dedicated-home-assistant-token
MCP_SERVER_NAME=Nara Home MCP
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO
ENTITIES_FILE=config/entities.example.yaml
HA_CONFIG_READ_ENABLED=false
HA_CONFIG_ROOT=
HA_CONFIG_REQUIRE_READ_ONLY_MOUNT=true
REQUEST_TIMEOUT_SECONDS=5
INVENTORY_REFRESH_INTERVAL_SECONDS=300
INVENTORY_REFRESH_TIMEOUT_SECONDS=30
INVENTORY_RETRY_BASE_SECONDS=5
INVENTORY_RETRY_MAX_SECONDS=60
INVENTORY_RETRY_JITTER_RATIO=0.2
ALLOW_DYNAMIC_ENTITIES=false
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
OAUTH_METADATA_ENABLED=false
OAUTH_ISSUER_URL=
OAUTH_RESOURCE_SERVER_URL=
OAUTH_REQUIRED_SCOPES=
NARA_MCP_VERSION=development
