# Render @NARA_USER@, @NARA_GROUP@ and @NARA_INSTALL_DIR@ before installing.
[Unit]
Description=Nara Home MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NARA_USER@
Group=@NARA_GROUP@
WorkingDirectory=@NARA_INSTALL_DIR@
EnvironmentFile=@NARA_INSTALL_DIR@/.env
ExecStart=@NARA_INSTALL_DIR@/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@NARA_INSTALL_DIR@

[Install]
WantedBy=multi-user.target
