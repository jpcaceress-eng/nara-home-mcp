[Unit]
Description=Nara Home MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nara-mcp
Group=nara-mcp
WorkingDirectory=/opt/nara-home-mcp
EnvironmentFile=/opt/nara-home-mcp/.env
ExecStart=/opt/nara-home-mcp/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nara-home-mcp

[Install]
WantedBy=multi-user.target

